# ─────────────────────────────────────────────────────────────────────────────
# LibreChat
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3080

# Open access: LibreChat requires an account (true anonymous is not supported), so we
# leave self-registration open to everyone. Set to false to lock it down later.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# Secrets — generate real values, do NOT commit the filled-in .env:
#   CREDS_KEY / JWT_SECRET / JWT_REFRESH_SECRET :  openssl rand -hex 32
#   CREDS_IV                                    :  openssl rand -hex 16
#   MEILI_MASTER_KEY                            :  openssl rand -hex 16
CREDS_KEY=REPLACE_with_openssl_rand_hex_32
CREDS_IV=REPLACE_with_openssl_rand_hex_16
JWT_SECRET=REPLACE_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_with_openssl_rand_hex_32
MEILI_MASTER_KEY=REPLACE_with_openssl_rand_hex_16

# ─────────────────────────────────────────────────────────────────────────────
# GLM 5.2 (the model / brain)  — recharge the GLM account before use
# ─────────────────────────────────────────────────────────────────────────────
GLM_API_KEY=your_glm_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# NOC MCP server (read-only)  — use a DEDICATED READ-ONLY NOC user, not an admin
# ─────────────────────────────────────────────────────────────────────────────
NOC_BASE_URL=https://www.manthanquench.online
NOC_EMAIL=your-readonly-noc-user@example.com
NOC_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Legacy CMS / old-NOC MCP server (read-only)  — quenchcms.com session login
# ─────────────────────────────────────────────────────────────────────────────
CMS_BASE_URL=https://quenchcms.com
CMS_USER=your-cms-username
CMS_PASS=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Ecog Jira MCP server (read-only)  — Atlassian Cloud, shared read-only account
# ─────────────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://ecog.atlassian.net
JIRA_EMAIL=your-readonly-jira-user@example.com
JIRA_API_TOKEN=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Ecog Jira Service Desk MCP (cookie/Playwright auth; MFA must be off)
# ─────────────────────────────────────────────────────────────────────────────
ECOG_BASE_URL=https://ecog.atlassian.net
ECOG_EMAIL=
ECOG_PASSWORD=
ECOG_COOKIE=
ECOG_HEADLESS=true
