# Change this ONE line if IP/domain changes. Every browser-facing URL (download links,
# share links, the admin panel) is derived from this in chat/docker-compose.yml — nothing
# else needs editing when the deployment moves to a new host or a real domain.
SERVER_HOST=172.16.12.188

# ─────────────────────────────────────────────────────────────────────────────
# LibreChat
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3080

# Open access: LibreChat requires an account (true anonymous is not supported), so we
# leave self-registration open to everyone. Set to false to lock it down later.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# This deployment is served over plain HTTP (no reverse proxy / TLS yet — P0-1 in
# docs/PRODUCTION-READINESS.md). Without this, LibreChat's NODE_ENV/DOMAIN_SERVER heuristic
# marks the refreshToken/token_provider cookies Secure. The browser DOES still store them
# (visible in DevTools -> Application -> Cookies), but a Secure cookie is never attached to a
# request made over a non-HTTPS connection -- so every POST /api/auth/refresh call goes out
# with no refresh cookie, and the app redirects to /login on every reload (F5). Remove/set
# back to true once P0-1 puts this behind HTTPS.
SESSION_COOKIE_SECURE=false

# DOCGEN_PUBLIC_BASE_URL / DOMAIN_CLIENT / DOMAIN_SERVER / VITE_API_BASE_URL are no longer
# set here — they're all derived from SERVER_HOST directly in chat/docker-compose.yml, and
# routed through the nginx service (chat/nginx.conf) on port 80.

# Secrets — generate real values, do NOT commit the filled-in .env:
#   CREDS_KEY / JWT_SECRET / JWT_REFRESH_SECRET :  openssl rand -hex 32
#   CREDS_IV                                    :  openssl rand -hex 16
#   MEILI_MASTER_KEY                            :  openssl rand -hex 16
CREDS_KEY=REPLACE_with_openssl_rand_hex_32
CREDS_IV=REPLACE_with_openssl_rand_hex_16
JWT_SECRET=REPLACE_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_with_openssl_rand_hex_32
MEILI_MASTER_KEY=REPLACE_with_openssl_rand_hex_16

# ─────────────────────────────────────────────────────────────────────────────
# GLM 5.2 (the model / brain)  — recharge the GLM account before use
# ─────────────────────────────────────────────────────────────────────────────
GLM_API_KEY=your_glm_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# NOC MCP server (read-only)  — use a DEDICATED READ-ONLY NOC user, not an admin
# ─────────────────────────────────────────────────────────────────────────────
NOC_BASE_URL=https://www.manthanquench.online
NOC_EMAIL=your-readonly-noc-user@example.com
NOC_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Legacy CMS / old-NOC MCP server (read-only)  — quenchcms.com session login
# ─────────────────────────────────────────────────────────────────────────────
CMS_BASE_URL=https://quenchcms.com
CMS_USER=your-cms-username
CMS_PASS=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Ecog Jira MCP server (read-only)  — Atlassian Cloud, shared read-only account
# ─────────────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://ecog.atlassian.net
JIRA_EMAIL=your-readonly-jira-user@example.com
JIRA_API_TOKEN=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Ecog Jira Service Desk MCP (cookie/Playwright auth; MFA must be off)
# ─────────────────────────────────────────────────────────────────────────────
ECOG_BASE_URL=https://ecog.atlassian.net
ECOG_EMAIL=
ECOG_PASSWORD=
ECOG_COOKIE=
ECOG_HEADLESS=true

# ChargeZone Jira (Quench / QCH project) — chargezone-jira-mcp-server
CZ_JIRA_BASE_URL=https://team-1604552506221.atlassian.net
CZ_JIRA_EMAIL=
CZ_JIRA_API_TOKEN=
