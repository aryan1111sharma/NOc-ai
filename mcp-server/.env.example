# NOC backend base URL (no trailing slash needed)
NOC_BASE_URL=https://www.manthanquench.online

# Service-account credentials.
# IMPORTANT: use a dedicated READ-ONLY NOC user in production, not an admin account.
NOC_EMAIL=your-readonly-noc-user@example.com
NOC_PASSWORD=change-me

# MCP transport: stdio (local clients like Claude Desktop) or http (remote / LibreChat)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8100
