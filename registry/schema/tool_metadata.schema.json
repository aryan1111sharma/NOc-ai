{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Tool Metadata (per-server, system-defined, immutable at runtime)",
  "type": "object",
  "required": ["schema_version", "mcp_server", "tools"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "mcp_server": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_name", "domain", "description", "capability", "risk"],
        "additionalProperties": false,
        "properties": {
          "tool_name": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "capability": { "enum": ["READ", "CONTROL", "WRITE", "DESTRUCTIVE"] },
          "risk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "classified_from": { "type": "string" },
              "last_reviewed": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
