# Legacy CMS (old NOC) base URL
CMS_BASE_URL=https://quenchcms.com

# Credentials for a CMS user (session/form login). Prefer a read-only account.
CMS_USER=your-cms-username
CMS_PASS=change-me

# MCP transport: stdio (local clients) or http (remote / LibreChat)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8101
